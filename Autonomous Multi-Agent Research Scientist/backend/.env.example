# Supabase credentials (from your Supabase project dashboard)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Primary model provider (required)
GEMINI_API_KEY="your-gemini-api-key"

# Fallback provider (optional, but needed for FI-01 fallback test)
GROQ_API_KEY="your-groq-api-key"

# Optional: Set this to true to artificially trigger FI-01 (RateLimitError on primary)
FI_01_FORCE_FAIL_PRIMARY="false"

# Qdrant
QDRANT_URL="https://your-qdrant-cluster.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"

# Neo4j
NEO4J_URI="neo4j+s://your-neo4j-aura.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
