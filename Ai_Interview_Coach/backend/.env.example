# AI Interview Coach - Environment Configuration Template
# Copy this file to .env and configure your variables

# Security Keys (replace with your own secure random strings in production)
SECRET_KEY=your-super-secret-key-change-this-in-production-xyz123
JWT_SECRET_KEY=jwt-super-secret-token-change-this-too-abc456

# Database Configuration (defaults to local SQLite instance)
DATABASE_URL=sqlite:///interview_coach_enterprise.db

# Flask Environment (development / production)
FLASK_ENV=development
FLASK_PORT=5000

# AI Provider Configuration (Optional)
# If left unset or invalid, the engine automatically uses the high-precision heuristic STAR method evaluator.
OPENAI_API_KEY=your_openai_api_key_here