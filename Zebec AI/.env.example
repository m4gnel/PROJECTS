PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_ENV=development
REACT_APP_ENABLE_ANALYTICS=false

