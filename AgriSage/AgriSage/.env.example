# ==============================================================================
# Agri-SAGE Environment Variables Configuration Example
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# 1. Database Configuration
DB_PASSWORD=local-only-change-me
# Compose supplies the password-bearing URL to the container. Keep local
# connection strings free of embedded credentials.
DATABASE_URL=postgresql+asyncpg://agrisage@localhost:5432/agrisage_dev

# 2. Authentication & Security
# Development-only value. Replace it before any shared or production deployment.
SECRET_KEY=dev-only-insecure-key-change-me

# 3. Environment & Operational Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=5

# 4. Object Storage (Cloudflare R2)
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=

# 5. Push Notifications & Speech APIs
FCM_KEY=
BHASHINI_API_KEY=
OTP_PROVIDER_KEY=
OTP_PROVIDER=disabled
OTP_PROVIDER_URL=
OTP_PROVIDER_SENDER=Agri-SAGE
OTP_PROVIDER_TIMEOUT_SECONDS=8
OTP_DEV_MODE=true

# 6. Payments (required only when subscriptions are enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 7. Weather & AI Providers
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATA_GOV_IN_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
OLLAMA_URL=http://localhost:11434
ENABLE_EMBEDDINGS=false
EMBEDDING_MODEL_PATH=
ALLOW_LOCAL_STORAGE=true

# 8. AI Model & Knowledge Base Versioning
MODEL_VERSION=v1.0.0
KNOWLEDGE_VERSION=2026-09-01

# 9. Crop Simulation Engine
DSSAT_BIN_PATH=/usr/local/bin/dscsm048

