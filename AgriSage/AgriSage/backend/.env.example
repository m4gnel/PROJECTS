# Backend environment variables — copy to .env and fill in.
# Never use these development defaults for a shared or production deployment.
DATABASE_URL=postgresql+asyncpg://agrisage@localhost:5432/agrisage_dev
DB_PASSWORD=local-only-change-me
GEMINI_API_KEY=
SECRET_KEY=dev-only-insecure-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=development

# Authentication and OTP. Production requires a real HTTPS generic HTTP
# provider; OTP_DEV_MODE is only for an explicitly local development session.
OTP_PROVIDER=disabled
OTP_PROVIDER_URL=
OTP_PROVIDER_KEY=
OTP_PROVIDER_SENDER=Agri-SAGE
OTP_PROVIDER_TIMEOUT_SECONDS=8
OTP_DEV_MODE=true

# Provider configuration
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
DATA_GOV_IN_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
OLLAMA_URL=http://localhost:11434
ENABLE_EMBEDDINGS=false
EMBEDDING_MODEL_PATH=

# Object storage and payments
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=
ALLOW_LOCAL_STORAGE=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
