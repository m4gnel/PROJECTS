# Public API origin used by the production access portal and operations console.
# Use an HTTPS origin (or a same-origin path such as /api) in production.
VITE_API_BASE_URL=

# Optional site path. Keep / for local development and custom domains.
# GitHub Pages supplies /AgriSage/ in its workflow.
VITE_BASE_PATH=/

# Local-only convenience. Production builds must leave this unset/false.
# Vite dev mode enables it automatically; this flag is for an intentional
# preview build only and never creates a real backend account.
VITE_ENABLE_DEMO_AUTH=false
